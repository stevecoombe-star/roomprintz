# STAGE transform gizmos. Server-only. Leave unset or off for the consumer default.
# off | allowlist | all
# VIBODE_STAGE_GIZMOS=off

# Comma-separated signed-in user UUIDs. Read only when VIBODE_STAGE_GIZMOS=allowlist.
# VIBODE_STAGE_GIZMOS_USER_IDS=

# Server-only Roboflow key for admin REMOVE SAM 3 segmentation.
# Leave unset until a live inference checkpoint. Never expose it to the browser.
# ROBOFLOW_API_KEY=
